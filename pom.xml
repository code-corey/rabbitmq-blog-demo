<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>io.github.codecorey</groupId>
    <artifactId>rabbitmq-learning</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>rabbitmq-learning</name>
    <description>RabbitMQ 练习项目（多模块），对应博客 RabbitMQ 系列各篇</description>

    <properties>
        <java.version>17</java.version>
        <amqp-client.version>5.21.0</amqp-client.version>
    </properties>

    <modules>
        <module>ch01-what-is-mq</module>
        <module>ch02-install-concepts</module>
        <module>ch03-programming-model</module>
        <module>ch04-queue-concepts</module>
        <module>ch05-messaging-patterns</module>
        <module>ch06-springboot</module>
        <module>ch07-queue-types</module>
        <module>ch08-dlx-delay</module>
        <module>ch09-sharding</module>
        <module>ch10-monitor-backup-federation</module>
        <module>ch11-cluster-ha</module>
        <module>ch12-classic-backlog-degradation</module>
        <module>ch13-amqp-and-protocols</module>
        <module>ch15-security</module>
        <module>ch16-virtual-hosts</module>
        <module>ch17-rpc</module>
    </modules>
</project>
